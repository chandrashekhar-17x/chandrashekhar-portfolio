# Copy to .env and fill in what you need:  cp .env.example .env
# .env is gitignored. Never commit real keys. Empty = feature disabled / default used.
# The phase where each value is first needed is in [brackets].

# ---------- App ----------
ENVIRONMENT=local                     # local | test | staging | production
DEBUG=false
CORS_ORIGINS=["http://localhost:4200"]  # JSON list; exact origins only, never "*"
# Public origin is embedded at build time in browser/SSR/SEO files; rebuild after changes.
PUBLIC_SITE_URL=http://localhost:4200
# Content API origin baked into the web build. Empty = use the bundled content/ files
# (fully static deploy). Set it once the API is hosted; add the site to CORS_ORIGINS too.
PUBLIC_API_URL=
NG_ALLOWED_HOSTS=                     # SSR host allow-list in prod, e.g. your-domain.dev,www.your-domain.dev

# ---------- Local Docker services [Phase 0] ----------
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio
POSTGRES_PORT=5433
REDIS_PORT=6380
OLLAMA_PORT=11434

# ---------- Database & cache [Phase 2] ----------
DATABASE_URL=postgresql+asyncpg://portfolio:portfolio@localhost:5433/portfolio
REDIS_URL=redis://localhost:6380/0
# Tests create and drop a throwaway database on this server (default: the make-up container).
TEST_DATABASE_URL=postgresql+asyncpg://portfolio:portfolio@localhost:5433/portfolio

# ---------- Contact form [Phase 2] ----------
TURNSTILE_SITE_KEY=                   # public (goes to the browser)
TURNSTILE_SECRET_KEY=                 # secret (server only)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# ---------- Admin auth [Phase 3] ----------
JWT_SECRET=                           # generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
ADMIN_EMAIL=
IP_HASH_SALT=                         # random string; IPs are stored only as salted hashes

# ---------- Object storage for uploads [Phase 3] ----------
S3_ENDPOINT_URL=                      # e.g. Cloudflare R2 endpoint
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ---------- LLM providers [Phase 4] ----------
LLM_PROVIDER=anthropic                # anthropic | groq | ollama
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=                       # embeddings
OLLAMA_BASE_URL=http://localhost:11434
DAILY_TOKEN_BUDGET=200000             # global kill-switch; scripted answers after this

# ---------- Tracing [Phase 4] ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------- Extras [Phase 8–9] ----------
GITHUB_TOKEN=                         # read-only, for the activity widget
SENTRY_DSN=
UMAMI_WEBSITE_ID=
