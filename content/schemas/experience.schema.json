{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experience.schema.json",
  "title": "Experience",
  "type": "object",
  "required": ["organizations", "roles"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "organizations": {
      "type": "array",
      "items": {
        "title": "Organization",
        "type": "object",
        "required": ["id", "name", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": ["company", "client", "freelance", "open-source"]
          },
          "url": {
            "$ref": "common.schema.json#/$defs/url"
          },
          "placeholder": {
            "$ref": "common.schema.json#/$defs/placeholder"
          },
          "monogram": {
            "description": "Neutral badge text instead of a logo, e.g. \"VD\".",
            "type": "string",
            "maxLength": 4
          }
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "title": "Role",
        "type": "object",
        "required": [
          "id",
          "org",
          "title",
          "employmentType",
          "start",
          "location",
          "highlights",
          "skills"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "org": {
            "description": "organizations[].id",
            "$ref": "common.schema.json#/$defs/id"
          },
          "title": {
            "type": "string"
          },
          "start": {
            "$ref": "common.schema.json#/$defs/yearMonth"
          },
          "end": {
            "description": "Omit while current.",
            "$ref": "common.schema.json#/$defs/yearMonth"
          },
          "location": {
            "type": "string"
          },
          "summary": {
            "type": "string",
            "maxLength": 600
          },
          "highlights": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "title": "Highlight",
              "type": "object",
              "required": ["text"],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string"
                },
                "project": {
                  "description": "projects[].slug this highlight links to.",
                  "$ref": "common.schema.json#/$defs/id"
                }
              }
            }
          },
          "skills": {
            "$ref": "common.schema.json#/$defs/skillRefs"
          },
          "placeholder": {
            "$ref": "common.schema.json#/$defs/placeholder"
          },
          "employmentType": {
            "enum": ["full-time", "internship", "contract", "freelance", "part-time"]
          },
          "workplace": {
            "enum": ["on-site", "hybrid", "remote"]
          }
        }
      }
    }
  }
}
