{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skills.schema.json",
  "title": "Skills",
  "type": "object",
  "required": ["skills"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "title": "Skill",
        "type": "object",
        "required": ["id", "name", "category"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "$ref": "common.schema.json#/$defs/category"
          },
          "placeholder": {
            "$ref": "common.schema.json#/$defs/placeholder"
          },
          "proficiency": {
            "description": "Strong / Good / Learning (shown honestly; \"learning\" = growing).",
            "enum": ["strong", "good", "learning"]
          },
          "concept": {
            "description": "A concept/technique node for the graph (no proficiency claimed).",
            "type": "boolean"
          }
        }
      }
    }
  }
}
