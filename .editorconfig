# One formatting baseline for every editor. See https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Python follows PEP 8 (4 spaces).
[*.py]
indent_size = 4

# Makefiles must use real tabs.
[Makefile]
indent_style = tab

[*.md]
max_line_length = off
trim_trailing_whitespace = false
